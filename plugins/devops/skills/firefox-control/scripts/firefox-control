#!/usr/bin/env bash
set -euo pipefail

WEFT_ROOT="${WEFT_ROOT:-/home/julian/dev/weft}"
TOKEN_FILE="/home/julian/.env"

if [[ ! -f "$TOKEN_FILE" ]]; then
  echo "Firefox control token file is missing: $TOKEN_FILE" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "$TOKEN_FILE"
set +a

exec python3 "$WEFT_ROOT/scripts/weft/tunnel_cmd.py" "$@"
