#!/usr/bin/env python3
"""wmachine — bring a whole machine up to fleet standard in one command.

Runs on the OWNER HOST (the box holding wtoken and the vault mint). Everything
it does on the target is idempotent, so a partial run is repaired by running it
again rather than needing a transaction: convergence, not installation.

  wmachine enroll <ssh-host> [--name NAME] [--no-vault] [--days N]
  wmachine check  <ssh-host>

Steps, each verified by reading the result back off the target:
  1  reachable over ssh, and has git + python3
  2  clone or fast-forward ~/dev/weft-fabric
  3  run agentsync — links every detected CLI, tools, and skills; writes a
     MACHINE.md stub; arms the commit hook
  4  install the hourly agentsync timer
  5  wtoken install — scoped vault token + rotation coverage   (skip: --no-vault)
  6  read back what actually landed

The target needs NO prior setup beyond sshd and your key. It does not need the
weft repo, the w* tools, or any credential in advance.
"""
from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
import json
from pathlib import Path

REPO_URL = "https://github.com/unattachedgray/weft-fabric"
REPO_DIR = "~/dev/weft-fabric"
HOST_RE = re.compile(r"^[A-Za-z0-9._-]+$")
WTOKEN = Path.home() / "dev" / "weft" / "scripts" / "weft" / "wtoken"
FLEET = Path.home() / ".config" / "agents" / "fleet.json"
JOURNALS = Path.home() / ".config" / "agents" / "enrollments"

OK, BAD, WARN = "  ok ", "FAIL ", "note "


def ssh(host: str, script: str, timeout: int = 300) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", host, "bash -s"],
        input=script, capture_output=True, text=True, timeout=timeout,
    )


def step(n: int, title: str) -> None:
    print(f"\n[{n}] {title}")


def report(status: str, msg: str) -> None:
    print(f"    {status} {msg}")


def register_machine(machine_id: str, host: str, vault: bool) -> None:
    """Record non-secret fleet identity independently of vault authority."""
    try:
        raw = json.loads(FLEET.read_text(encoding="utf-8")) if FLEET.exists() else {}
    except json.JSONDecodeError:
        raise RuntimeError(f"refusing to overwrite invalid fleet registry: {FLEET}")
    machines = raw.setdefault("machines", {})
    machines[machine_id] = {"host": host, "vault": "enrolled" if vault else "not-requested"}
    raw["version"] = 1
    FLEET.parent.mkdir(parents=True, exist_ok=True)
    tmp = FLEET.with_suffix(".tmp")
    tmp.write_text(json.dumps(raw, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp.chmod(0o600)
    tmp.replace(FLEET)


def record_enrollment(machine_id: str, host: str, step_name: str, state: str, detail: str = "") -> None:
    """Atomically retain enough progress to explain or resume a partial enrolment."""
    JOURNALS.mkdir(parents=True, exist_ok=True)
    path = JOURNALS / f"{machine_id}.json"
    try:
        raw = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
    except json.JSONDecodeError:
        raw = {}
    raw.update({"version": 1, "machine": machine_id, "host": host,
                "last_step": step_name, "state": state})
    if detail:
        raw["detail"] = detail[:300]
    history = raw.setdefault("history", [])
    history.append({"step": step_name, "state": state})
    raw["history"] = history[-20:]
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(raw, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp.chmod(0o600)
    tmp.replace(path)


def previous_enrollment(machine_id: str) -> dict:
    try:
        raw = json.loads((JOURNALS / f"{machine_id}.json").read_text(encoding="utf-8"))
        return raw if isinstance(raw, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def check_host(host: str) -> bool:
    if not HOST_RE.fullmatch(host):
        print(f"refused: {host!r} must be an ssh config alias, not options or a command", file=sys.stderr)
        return False
    return True


def cmd_check(host: str) -> int:
    """Read-only: what state is this machine in?"""
    if not check_host(host):
        return 2
    probe = r"""
set -u
export PATH="$HOME/.local/bin:$HOME/bin:/usr/local/bin:/usr/local/sbin:/snap/bin:/opt/homebrew/bin:$PATH"
echo "os=$(. /etc/os-release 2>/dev/null && echo "$PRETTY_NAME" || uname -s)"
echo "git=$(command -v git >/dev/null && echo yes || echo NO)"
echo "python3=$(command -v python3 >/dev/null && echo yes || echo NO)"
repo=~/dev/weft-fabric
[ -d "$repo/.git" ] || repo=~/dev/claude-skills
echo "repo=$([ -d "$repo/.git" ] && git -C "$repo" rev-parse --short HEAD || echo ABSENT)"
echo "machine_md=$([ -f ~/.config/agents/MACHINE.md ] && echo yes || echo NO)"
echo "timer=$(systemctl --user is-active agentsync.timer 2>/dev/null || echo none)"
echo "vault=$([ -f ~/.config/weft/vault-token ] && echo yes || echo NO)"
if [ -x "$repo/scripts/agentsync" ] && "$repo/scripts/agentsync" --help 2>&1 | grep -q -- '--check'; then
  report=$("$repo/scripts/agentsync" --check --json); rc=$?
  [ "$rc" -eq 0 ] || [ "$rc" -eq 2 ] || exit "$rc"
  printf 'agent_report=%s\n' "$report"
else
  echo 'agent_report={"state":"outdated","detected_clis":[]}'
fi
exit 0
"""
    r = ssh(host, probe, timeout=60)
    if r.returncode != 0:
        print(f"{BAD} cannot reach {host}: {r.stderr.strip().splitlines()[-1] if r.stderr.strip() else r.returncode}")
        return 1
    print(f"{host}:")
    clis = []
    agent_state = "unknown"
    for line in r.stdout.splitlines():
        if line.startswith("agent_report="):
            try:
                report_data = json.loads(line.split("=", 1)[1])
                clis = report_data.get("detected_clis", [])
                agent_state = report_data.get("state", "unknown")
            except json.JSONDecodeError:
                agent_state = "protocol-error"
        elif "=" in line:
            k, v = line.split("=", 1)
            print(f"    {k:<11} {v}")
    print(f"    {'clis':<11} {', '.join(clis) or 'none detected'}")
    print(f"    {'agent state':<11} {agent_state}")
    return 0


def cmd_enroll(host: str, name: str | None, vault: bool, days: int) -> int:
    if not check_host(host):
        return 2
    name = name or f"{host}-wvault"
    if not HOST_RE.fullmatch(name):
        print(f"refused: machine name {name!r} may contain only letters, digits, dot, underscore, and dash", file=sys.stderr)
        return 2
    previous = previous_enrollment(name)
    if previous and previous.get("state") != "complete":
        print(f"resuming after {previous.get('last_step', 'an earlier step')} ({previous.get('state', 'unknown')})")
    print(f"enrolling {host} as {name}")
    record_enrollment(name, host, "start", "running")

    step(1, "reachability and prerequisites")
    r = ssh(host, "command -v git >/dev/null && command -v python3 >/dev/null && echo READY || echo MISSING", timeout=60)
    if r.returncode != 0:
        record_enrollment(name, host, "prerequisites", "failed", "ssh failed")
        report(BAD, f"ssh to {host} failed — is sshd up and your key installed?")
        return 1
    if "READY" not in r.stdout:
        record_enrollment(name, host, "prerequisites", "failed", "git or python3 missing")
        report(BAD, "target lacks git and/or python3 — install them there first")
        return 1
    report(OK, "ssh works; git and python3 present")
    record_enrollment(name, host, "prerequisites", "complete")

    step(2, "clone or update the shared repo")
    r = ssh(host, f"""
set -eu
mkdir -p ~/dev
if [ ! -e {REPO_DIR} ] && [ -d ~/dev/claude-skills/.git ] && [ ! -L ~/dev/claude-skills ]; then
  mv ~/dev/claude-skills {REPO_DIR}
  ln -s {REPO_DIR} ~/dev/claude-skills
fi
if [ -d {REPO_DIR}/.git ]; then
  git -C {REPO_DIR} remote set-url origin {REPO_URL}
  git -C {REPO_DIR} pull --ff-only --quiet 2>/dev/null || echo "  (pull skipped)"
else
  git clone --quiet {REPO_URL} {REPO_DIR}
fi
git -C {REPO_DIR} rev-parse --short HEAD
""")
    if r.returncode != 0:
        record_enrollment(name, host, "repository", "failed", r.stderr)
        report(BAD, f"clone/update failed: {r.stderr.strip()[:200]}")
        return 1
    report(OK, f"repo at {r.stdout.strip().splitlines()[-1]}")
    record_enrollment(name, host, "repository", "complete")

    step(3, "converge every CLI on the target")
    r = ssh(host, f"{REPO_DIR}/scripts/agentsync")
    if r.returncode != 0:
        record_enrollment(name, host, "convergence", "failed", r.stderr or r.stdout)
        report(BAD, f"agentsync failed: {(r.stderr or r.stdout).strip()[:300]}")
        return 1
    for line in r.stdout.splitlines():
        if line.strip():
            report("     ", line.rstrip())
    record_enrollment(name, host, "convergence", "complete")

    step(4, "install the hourly timer")
    r = ssh(host, f"{REPO_DIR}/scripts/agentsync --install-timer")
    report(OK if r.returncode == 0 else WARN,
           (r.stdout or r.stderr).strip().splitlines()[-1] if (r.stdout or r.stderr).strip() else "no scheduler")
    record_enrollment(name, host, "scheduler", "complete" if r.returncode == 0 else "warning")

    if vault:
        step(5, "vault enrollment (mints a scoped token)")
        if not WTOKEN.is_file():
            report(WARN, f"wtoken not found at {WTOKEN} — run this from the owner host to enrol the vault")
        else:
            r = subprocess.run([str(WTOKEN), "install", name, host, "default", "--days", str(days)],
                               capture_output=True, text=True, timeout=300)
            for line in (r.stdout or r.stderr).strip().splitlines():
                report(OK if r.returncode == 0 else BAD, line)
            if r.returncode != 0:
                record_enrollment(name, host, "vault", "failed", "vault installation failed")
                return 1
            record_enrollment(name, host, "vault", "complete")
    else:
        step(5, "vault enrollment skipped (--no-vault)")

    step(6, "read back what actually landed")
    rc = cmd_check(host)
    if rc == 0:
        register_machine(name, host, vault)
        record_enrollment(name, host, "verified", "complete")
        report(OK, "added to fleet inventory")
    return rc


def _local_ips() -> set[str]:
    """Addresses that mean 'this host' — so a registry entry of host=local matches."""
    out = {"127.0.0.1", "localhost"}
    r = subprocess.run(["ip", "-o", "addr"], capture_output=True, text=True)
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) > 3 and parts[2] in ("inet", "inet6"):
            out.add(parts[3].split("/")[0])
    return out


def tailscale_bin() -> str | None:
    """Return a tailscale CLI that is actually logged in.

    A machine can have more than one (a WSL box sees both its own tailscaled
    and the Windows host's). Picking the first one on PATH found a logged-out
    daemon, whose status reports Peer: null rather than failing — so verify
    the backend is Running instead of trusting that the binary exists.
    """
    import json as _j
    for c in ("tailscale", "/usr/bin/tailscale", "/usr/sbin/tailscale",
              "/mnt/c/Program Files/Tailscale/tailscale.exe"):
        if not (shutil.which(c) or Path(c).is_file()):
            continue
        try:
            r = subprocess.run([c, "status", "--json"], capture_output=True, text=True, timeout=20)
            if r.returncode == 0 and (_j.loads(r.stdout) or {}).get("BackendState") == "Running":
                return c
        except (OSError, ValueError, subprocess.TimeoutExpired):
            continue
    return None


def cmd_discover(do_enroll: bool, days: int) -> int:
    """Find tailnet machines that are not enrolled yet.

    The tailnet is already an accurate inventory of every machine you own, so
    there is no second registry to keep in step. Anything online that is not in
    vault-machines.json is either new or was never finished.
    """
    ts = tailscale_bin()
    if not ts:
        print("no tailscale CLI found — cannot discover", file=sys.stderr)
        return 1
    raw = subprocess.run([ts, "status", "--json"], capture_output=True, text=True, timeout=30)
    if raw.returncode != 0:
        print("tailscale status failed", file=sys.stderr)
        return 1
    import json as _json
    data = _json.loads(raw.stdout)

    # Match enrolled machines by RESOLVED ADDRESS, not by name. Registry keys are
    # ssh aliases ("workstation-wvault") and bear no resemblance to tailnet
    # hostnames ("venge-ubuntu"), so name matching silently reports everything
    # as new. `ssh -G` gives the address an alias actually resolves to.
    known_ips: set[str] = set()
    registry_path = Path.home() / ".config/weft/vault-machines.json"
    try:
        registry = _json.loads(registry_path.read_text())
    except (OSError, ValueError):
        registry = {}
        print(f"note: no registry at {registry_path} — run discover on the owner host "
              f"for accurate enrolment status\n", file=sys.stderr)
    for meta in registry.values():
        alias = (meta or {}).get("host", "")
        if not alias or alias == "local":
            known_ips.update(_local_ips())
            continue
        g = subprocess.run(["ssh", "-G", alias], capture_output=True, text=True, timeout=15)
        for line in g.stdout.splitlines():
            if line.startswith("hostname "):
                known_ips.add(line.split(None, 1)[1].strip())

    peers = []
    for p in (data.get("Peer") or {}).values():
        if p.get("Online"):
            peers.append((p.get("HostName", "?"), (p.get("TailscaleIPs") or ["?"])[0], p.get("OS", "")))
    self_ = data.get("Self") or {}
    peers.append((self_.get("HostName", "?"), (self_.get("TailscaleIPs") or ["?"])[0], self_.get("OS", "") + " (this host)"))

    print(f"{'TAILNET HOST':<26}{'IP':<17}{'OS':<20}{'SSH':<8}ENROLLED")
    new = []
    for host, ip, osname in sorted(peers):
        enrolled = ip in known_ips
        reachable = "-"
        if not enrolled and ip != "?":
            r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=6",
                                "-o", "StrictHostKeyChecking=accept-new", ip, "true"],
                               capture_output=True, timeout=20)
            reachable = "yes" if r.returncode == 0 else "no"
            if reachable == "yes":
                new.append((host, ip))
        print(f"{host:<26}{ip:<17}{osname:<20}{reachable:<8}{'yes' if enrolled else 'NO'}")

    if not new:
        print("\nnothing new that is reachable.")
        return 0
    print(f"\n{len(new)} unenrolled machine(s) reachable over ssh:")
    for host, ip in new:
        alias = re.sub(r"[^A-Za-z0-9-]", "-", host).lower()
        print(f"  {host}  ->  wmachine enroll {alias}   (add an ssh alias for {ip} first)")
    if do_enroll:
        print("\n--enroll given: adding ssh aliases and enrolling")
        cfg = Path.home() / ".ssh" / "config"
        for host, ip in new:
            alias = re.sub(r"[^A-Za-z0-9-]", "-", host).lower()
            block = (f"\n# added by wmachine discover\nHost {alias}\n    HostName {ip}\n"
                     f"    User {os.environ.get('USER', 'julian')}\n"
                     f"    IdentityFile ~/.ssh/id_ed25519\n    ServerAliveInterval 30\n")
            text = cfg.read_text(encoding="utf-8") if cfg.exists() else ""
            if f"Host {alias}\n" not in text:
                cfg.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
                cfg.write_text(text + block, encoding="utf-8")
                cfg.chmod(0o600)
                print(f"  added ssh alias {alias} -> {ip}")
            cmd_enroll(alias, None, True, days)
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="action", required=True)
    d = sub.add_parser("discover", help="find tailnet machines that are not enrolled")
    d.add_argument("--enroll", action="store_true", help="add ssh aliases and enrol what it finds")
    d.add_argument("--days", type=int, default=30)
    e = sub.add_parser("enroll", help="bring a machine up to fleet standard")
    e.add_argument("host")
    e.add_argument("--name", help="vault token name (default <host>-wvault)")
    e.add_argument("--no-vault", action="store_true", help="skip minting a vault token")
    e.add_argument("--days", type=int, default=30, help="token TTL in days")
    c = sub.add_parser("check", help="report a machine's state, change nothing")
    c.add_argument("host")
    a = ap.parse_args()

    if not shutil.which("ssh"):
        print("wmachine: ssh not found", file=sys.stderr)
        return 2
    if a.action == "discover":
        return cmd_discover(a.enroll, a.days)
    if a.action == "check":
        return cmd_check(a.host)
    return cmd_enroll(a.host, a.name, not a.no_vault, a.days)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.TimeoutExpired:
        print("wmachine: timed out talking to the target", file=sys.stderr)
        raise SystemExit(1)
    except KeyboardInterrupt:
        raise SystemExit(130)
