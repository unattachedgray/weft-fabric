#!/usr/bin/env python3
"""Weft Fabric — one command for every agent CLI and machine.

  wagent status [--full]       truthful fleet health (local health on a leaf)
  wagent sync [--local]        update every reachable machine, or only this one
  wagent enroll <ssh-host>     completely add a machine
  wagent check <ssh-host>      inspect one machine
  wagent discover [--enroll]   find new tailnet machines
  wagent doctor [--json]       inspect this machine's live wiring

Legacy agentsync/wfleet/wmachine commands remain compatibility aliases.
"""
from __future__ import annotations

import json
from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[1]
AGENTSYNC = ROOT / "scripts" / "agentsync"
WFLEET = ROOT / "tools" / "wfleet"
WMACHINE = ROOT / "tools" / "wmachine"
FLEET = Path.home() / ".config" / "agents" / "fleet.json"
LEGACY_FLEET = Path.home() / ".config" / "weft" / "vault-machines.json"


def run(command: list[str]) -> int:
    return subprocess.run(command).returncode


def has_fleet() -> bool:
    return FLEET.is_file() or LEGACY_FLEET.is_file()


def doctor(args: list[str]) -> int:
    machine = subprocess.run([str(AGENTSYNC), "--check", "--json"], capture_output=True, text=True)
    try:
        report = json.loads(machine.stdout)
    except json.JSONDecodeError:
        print("Weft Fabric could not read its health sensor.", file=sys.stderr)
        return 1
    if "--json" in args:
        print(json.dumps(report, sort_keys=True))
    else:
        print(f"Weft Fabric on {report.get('host', '?')}: {report.get('state', 'unknown')}")
        print(f"  CLIs: {', '.join(report.get('detected_clis', [])) or 'none'}")
        if report.get("changes"):
            print(f"  Repairable drift: {len(report['changes'])} item(s) — run `wagent sync --local`")
        for error in report.get("errors", []):
            print(f"  Problem: {error}")
    return machine.returncode


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    action, args = sys.argv[1], sys.argv[2:]
    if action == "doctor":
        return doctor(args)
    if action == "status":
        return run([str(WFLEET), "status", *args]) if has_fleet() else doctor(args)
    if action == "sync":
        local = "--local" in args or not has_fleet()
        forwarded = [a for a in args if a != "--local"]
        return run([str(AGENTSYNC), *forwarded]) if local else run([str(WFLEET), "sync", *forwarded])
    if action in ("enroll", "check", "discover"):
        return run([str(WMACHINE), action, *args])
    print(f"wagent: unknown command {action!r}\n\n{__doc__.strip()}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
