#!/usr/bin/env python3
"""wfleet — is every machine actually converged?

Status is read-only. It asks each machine's own agentsync reconciler for the
truth instead of duplicating CLI detection and link checks here.

  wagent status          one line per machine: config, drift, CLIs, timer
  wagent status --full   also list each machine's detected CLIs
  wagent sync            converge every reachable machine

Machines come from ~/.config/agents/fleet.json. The old vault registry is read
as a migration fallback, but vault access is optional and no longer defines
fleet membership. A machine whose host is "local" is checked in place.

Silent drift is the failure mode this exists to kill: a symlink to a stale
commit resolves exactly like a symlink to a current one, so nothing breaks
loudly when a box falls behind. This turns that into a number.
"""
from __future__ import annotations

import argparse
import concurrent.futures as cf
import json
import subprocess
import sys
from pathlib import Path

REGISTRY = Path.home() / ".config" / "agents" / "fleet.json"
LEGACY_REGISTRY = Path.home() / ".config" / "weft" / "vault-machines.json"
REPO_DIR = "~/dev/weft-fabric"

PROBE = r"""
set -u
export PATH="$HOME/.local/bin:$HOME/bin:/usr/local/bin:/usr/local/sbin:/snap/bin:/opt/homebrew/bin:$PATH"
t=$(systemctl --user is-active weft-fabric-sync.timer 2>/dev/null || true)
if [ -z "$t" ] || [ "$t" = inactive ]; then
  legacy=$(systemctl --user is-active agentsync.timer 2>/dev/null || true)
  [ -z "$legacy" ] || t="legacy-$legacy"
fi
printf '{"timer":"%s","agentsync":' "${t:-none}"
repo=~/dev/weft-fabric
[ -x "$repo/scripts/agentsync" ] || repo=~/dev/claude-skills
if [ -x "$repo/scripts/agentsync" ]; then
  if "$repo/scripts/agentsync" --help 2>&1 | grep -q -- '--check'; then
    "$repo/scripts/agentsync" --check --json
    rc=$?
    [ "$rc" -eq 0 ] || [ "$rc" -eq 2 ] || exit "$rc"
  else
    printf '{"protocol":0,"state":"outdated","detected_clis":[],"errors":["update shared agent repo"]}\n'
  fi
else
  printf '{"protocol":1,"state":"missing","detected_clis":[],"errors":["agentsync absent"]}\n'
fi
printf '}\n'
"""

def _read_registry(path: Path) -> dict:
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    return raw.get("machines", raw) if isinstance(raw, dict) else {}


def registry() -> dict[str, str]:
    # Fleet identity wins; legacy vault entries only fill migration gaps.
    data = _read_registry(LEGACY_REGISTRY)
    data.update(_read_registry(REGISTRY))
    return {name: meta.get("host", "") for name, meta in data.items()
            if isinstance(meta, dict) and isinstance(meta.get("host"), str)}


def probe(name: str, host: str) -> dict:
    out = {"name": name, "host": host, "fingerprint": "?", "timer": "?", "clis": [], "state": "unknown", "err": ""}
    try:
        if host == "local":
            r = subprocess.run(["bash", "-s"], input=PROBE, capture_output=True, text=True, timeout=45)
        else:
            r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", host, "bash -s"],
                               input=PROBE, capture_output=True, text=True, timeout=45)
        if r.returncode not in (0, 2):
            out["err"] = "unreachable"
            return out
        payload = json.loads(r.stdout)
        report = payload.get("agentsync") or {}
        out.update(timer=payload.get("timer", "?"), state=report.get("state", "unknown"),
                   fingerprint=report.get("repo_fingerprint", "?")[:7],
                   clis=report.get("detected_clis", []), errors=report.get("errors", []))
    except subprocess.TimeoutExpired:
        out["err"] = "timeout"
    except json.JSONDecodeError:
        out["err"] = "protocol-error"
    except OSError as e:
        out["err"] = str(e)[:40]
    return out


def local_head() -> str:
    r = subprocess.run(["git", "-C", str(Path(__file__).resolve().parents[1]),
                        "rev-parse", "--short", "HEAD"], capture_output=True, text=True)
    return r.stdout.strip() or "?"


def cmd_status(full: bool) -> int:
    machines = registry()
    if not machines:
        print(f"no machines in {REGISTRY} — enrol one with `wmachine enroll <ssh-host>`", file=sys.stderr)
        return 1
    ref = local_head()
    print(f"fleet health  (controller {ref})\n")
    with cf.ThreadPoolExecutor(max_workers=8) as pool:
        rows = list(pool.map(lambda kv: probe(*kv), sorted(machines.items())))

    print(f"{'MACHINE':<22}{'HOST':<10}{'CONFIG':<10}{'STATE':<12}{'TIMER':<10}CLIS")
    counts = {"ok": 0, "drifted": 0, "unreachable": 0, "outdated": 0,
              "protocol-error": 0, "error": 0, "unknown": 0, "missing": 0}
    for r in rows:
        if r["err"]:
            state, fingerprint, timer = r["err"], "-", "-"
        else:
            state, fingerprint, timer = r["state"], r["fingerprint"], r["timer"]
        counts[state if state in counts else "unknown"] += 1
        clis = ", ".join(r["clis"]) if full else str(len(r["clis"])) + " detected"
        print(f"{r['name']:<22}{r['host']:<10}{fingerprint:<10}{state:<12}{timer:<10}{clis}")

    print()
    summary = "  ".join(f"{k}={v}" for k, v in counts.items() if v)
    print(summary or "no machines")
    unhealthy = sum(v for k, v in counts.items() if k != "ok")
    if unhealthy:
        print("run `wagent sync` to repair reachable drift; unreachable machines retain their last state")
    return 1 if unhealthy else 0


def cmd_sync() -> int:
    machines = registry()
    rc = 0
    for name, host in sorted(machines.items()):
        print(f"\n=== {name} ({host}) ===")
        # The first sync after the rebrand migrates the checkout in place and
        # leaves a compatibility symlink for already-running sessions.
        cmd = r'''set -eu
old="$HOME/dev/claude-skills"
new="$HOME/dev/weft-fabric"
if [ ! -e "$new" ] && [ -d "$old/.git" ] && [ ! -L "$old" ]; then
  mv "$old" "$new"
  ln -s "$new" "$old"
fi
repo="$new"
[ -d "$repo/.git" ] || repo="$old"
# Preserve a working authenticated remote. Leaf machines need no GitHub
# credential because the content plane is public; fall back to HTTPS when an
# owner-host SSH remote is not usable there.
if ! timeout 15 git -C "$repo" ls-remote origin HEAD >/dev/null 2>&1; then
  git -C "$repo" remote set-url origin https://github.com/unattachedgray/weft-fabric
fi
# An older checkout may predate wagent. Its reconciler can pull the release;
# only then is it safe to enter through the new front door.
if [ ! -x "$repo/tools/wagent" ]; then "$repo/scripts/agentsync"; fi
"$repo/tools/wagent" sync --local --no-pull
"$repo/scripts/agentsync" --install-timer
'''
        if host == "local":
            r = subprocess.run(["bash", "-lc", cmd], capture_output=True, text=True, timeout=300)
        else:
            r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", host, "bash -s"],
                               input=cmd, capture_output=True, text=True, timeout=300)
        print((r.stdout or r.stderr).strip() or f"(no output, rc={r.returncode})")
        rc |= 0 if r.returncode == 0 else 1
    return rc


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="action", required=True)
    s = sub.add_parser("status", help="report convergence across the fleet")
    s.add_argument("--full", action="store_true", help="list detected CLIs per machine")
    sub.add_parser("sync", help="run agentsync on every reachable machine")
    a = ap.parse_args()
    return cmd_status(a.full) if a.action == "status" else cmd_sync()


if __name__ == "__main__":
    raise SystemExit(main())
