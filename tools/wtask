#!/usr/bin/env python3
"""wtask / wnote / wrecall — owner-host weft tools, reachable from any machine.

The real implementations live in the weft repo and are backed by state on the
OWNER HOST: wtask by a file (~/.local/share/weft/tasks.json), wnote and wrecall
by the vault API on its loopback. So a machine without the weft repo cannot run
them locally — but it can reach them over the SSH trust that already exists.

This shim resolves that automatically:
  * weft repo present locally  -> exec the real tool
  * otherwise                  -> run it on the owner host over SSH

ONE FILE, THREE NAMES. `wnote` and `wrecall` are symlinks to this file and it
dispatches on the name it was invoked as, so the remote-quoting logic exists
once. Measured 2026-09-17 on a leaf: skills told agents to run
`bash ~/dev/weft/scripts/weft/wrecall`, a path only the owner host has, and a
session's research could not be banked at all. Stdin passes through ssh, so
`… | wnote <slug>` works from a leaf. Leaf writes are an owner decision
(2026-09-17): the SSH trust already exceeds the leaf's read-only vault token.

That makes the shared core's "run wtask brief at session start" rule, and the
recall/bank steps of session-recall and research-first, work everywhere
instead of only on the owner host.

Owner host resolution, first hit wins:
  $WEFT_OWNER_HOST  ->  ~/.config/agents/owner-host  ->  "venge"
The value must be an ssh config alias, not a command.
"""
from __future__ import annotations

import os
from pathlib import Path
import re
import shutil
import subprocess
import sys

TOOLS = ("wtask", "wnote", "wrecall")
NAME = Path(sys.argv[0]).name if Path(sys.argv[0]).name in TOOLS else "wtask"
LOCAL = Path.home() / "dev" / "weft" / "scripts" / "weft" / NAME
REMOTE = f"~/dev/weft/scripts/weft/{NAME}"
ALIAS = re.compile(r"^[A-Za-z0-9._-]+$")


def owner_host() -> str:
    env = os.environ.get("WEFT_OWNER_HOST", "").strip()
    if env:
        return env
    cfg = Path.home() / ".config" / "agents" / "owner-host"
    try:
        value = cfg.read_text(encoding="utf-8").strip()
        if value:
            return value
    except OSError:
        pass
    return "venge"


def main(argv: list[str]) -> int:
    if LOCAL.is_file():
        os.execv(str(LOCAL), [str(LOCAL), *argv])

    host = owner_host()
    if not ALIAS.fullmatch(host):
        print(f"{NAME}: refusing suspicious owner host {host!r} — must be an ssh alias", file=sys.stderr)
        return 2
    if not shutil.which("ssh"):
        print(f"{NAME}: no local weft repo and no ssh to reach the owner host", file=sys.stderr)
        return 2

    # Quote each argument for the remote shell; never interpolate raw.
    from shlex import quote
    remote_cmd = " ".join([REMOTE, *(quote(a) for a in argv)])
    result = subprocess.run(
        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", host, remote_cmd]
    )
    if result.returncode == 255:
        print(f"{NAME}: could not reach owner host '{host}'. Its state lives "
              f"there; set $WEFT_OWNER_HOST or ~/.config/agents/owner-host if that is wrong.",
              file=sys.stderr)
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
