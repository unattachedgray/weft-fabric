#!/usr/bin/env python3
"""Local scoped-secret registrar and launcher.

Secrets are entered directly in the terminal, stored in mode-0600 scope files,
and never printed.  `run` injects only requested scopes into one child process.
"""
from __future__ import annotations

import argparse
import base64
import getpass
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys

ROOT = Path.home() / ".config" / "weft" / "secrets"
MANIFEST = ROOT / "manifest.json"
KEY = re.compile(r"^[A-Z][A-Z0-9_]*$")
SCOPES = ("llm", "github", "browser", "weft", "publishing", "messaging", "infrastructure", "misc")
NON_SECRET_HINTS = frozenset({"WEFT_VAULT_TOKEN_FILE"})
HOST = re.compile(r"^[A-Za-z0-9._-]+$")
PORTABLE_SCOPES = frozenset({"llm"})


def _private(path: Path) -> None:
    path.chmod(0o600)


def _read_env(path: Path) -> dict[str, str]:
    values = {}
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return values
    for line in lines:
        if not line or line.lstrip().startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if KEY.fullmatch(key.strip()):
            values[key.strip()] = value
    return values


def _write_env(path: Path, values: dict[str, str]) -> None:
    ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    ROOT.chmod(0o700)
    pending = path.with_suffix(path.suffix + ".next")
    fd = os.open(pending, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        stream.write("".join(f"{key}={values[key]}\n" for key in sorted(values)))
    os.replace(pending, path)
    _private(path)


def _manifest() -> dict[str, dict[str, str]]:
    try:
        data = json.loads(MANIFEST.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def _save_manifest(data: dict[str, dict[str, str]]) -> None:
    ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    ROOT.chmod(0o700)
    pending = MANIFEST.with_suffix(".json.next")
    pending.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    _private(pending)
    os.replace(pending, MANIFEST)


def suggest_scope(name: str) -> str:
    if name.startswith(("OPENAI", "GEMINI", "GROQ", "MISTRAL", "CEREBRAS", "DEEPSEEK", "HF_", "JINA", "ELEVENLABS", "API_KEY", "OPENROUTER")):
        return "llm"
    if name.startswith("GH_"):
        return "github"
    if "BROWSER_TUNNEL" in name:
        return "browser"
    if name.startswith("WEFT"):
        return "weft"
    if name.startswith(("WP_", "WU_")):
        return "publishing"
    if name.startswith("DISCORD"):
        return "messaging"
    if name.startswith(("CLOUDFLARE", "DREAMHOST", "SD_")):
        return "infrastructure"
    return "misc"


def looks_secret(name: str) -> bool:
    return name not in NON_SECRET_HINTS and bool(
        re.search(r"(^API_KEY$|KEY|TOKEN|SECRET|PASSWORD|_PW$|AUTH|COOKIE)", name)
    )


def put(name: str, scope: str, value: str) -> None:
    if not KEY.fullmatch(name):
        raise ValueError("name must be uppercase letters, digits, and underscores")
    if scope not in SCOPES:
        raise ValueError(f"scope must be one of: {', '.join(SCOPES)}")
    if not value:
        raise ValueError("secret cannot be empty")
    if "\n" in value or "\r" in value:
        raise ValueError("secret must be a single-line value")
    # One authoritative location: remove an older copy from another scope.
    for path in ROOT.glob("*.env") if ROOT.exists() else ():
        values = _read_env(path)
        if name in values and path.stem != scope:
            del values[name]
            _write_env(path, values)
    path = ROOT / f"{scope}.env"
    values = _read_env(path)
    values[name] = value
    _write_env(path, values)
    manifest = _manifest()
    manifest[name] = {"scope": scope}
    _save_manifest(manifest)


def cmd_add(args) -> int:
    name = args.name or input("Credential variable name (for example OPENAI_API_KEY): ").strip()
    proposed = suggest_scope(name)
    scope = args.scope or input(f"Scope [{proposed}] ({', '.join(SCOPES)}): ").strip() or proposed
    first = getpass.getpass("Paste secret (hidden): ")
    second = getpass.getpass("Paste again to confirm: ")
    if first != second:
        print("wsecret: entries did not match; nothing written", file=sys.stderr)
        return 1
    put(name, scope, first)
    print(f"registered {name} in {scope} scope; value was not displayed")
    return cmd_doctor(argparse.Namespace())


def cmd_list(_args) -> int:
    for name, meta in sorted(_manifest().items()):
        print(f"{name}\t{meta.get('scope', 'unknown')}")
    return 0


def _catalog() -> dict[str, dict[str, str]]:
    """Return registered values indexed by name; callers must never print it."""
    found = {}
    for name, meta in _manifest().items():
        scope = meta.get("scope", "")
        if scope in SCOPES:
            value = _read_env(ROOT / f"{scope}.env").get(name)
            if value:
                found[name] = {"scope": scope, "value": value}
    return found


REMOTE_PROVISIONER = r'''import json, os, re, stat, sys
from pathlib import Path

KEY = re.compile(r"^[A-Z][A-Z0-9_]*$")
SCOPES = {"llm", "github", "browser", "weft", "publishing", "messaging", "infrastructure", "misc"}
root = Path.home() / ".config" / "weft" / "secrets"

def read_env(path):
    out = {}
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return out
    for line in lines:
        if line and not line.lstrip().startswith("#") and "=" in line:
            name, value = line.split("=", 1)
            if KEY.fullmatch(name.strip()):
                out[name.strip()] = value
    return out

try:
    request = json.load(sys.stdin)
    incoming = request["credentials"]
    replace = request.get("replace") is True
    if not isinstance(incoming, dict) or not incoming:
        raise ValueError("no credentials supplied")
    staged = {scope: read_env(root / f"{scope}.env") for scope in SCOPES}
    owners = {name: scope for scope, values in staged.items() for name in values}
    touched = set()
    conflicts = []
    for name, item in incoming.items():
        scope, value = item["scope"], item["value"]
        if not KEY.fullmatch(name) or scope not in SCOPES or not isinstance(value, str) or not value or "\n" in value or "\r" in value:
            raise ValueError(f"invalid credential record: {name!r}")
        old_scope = owners.get(name)
        if old_scope is not None and not replace:
            conflicts.append(name)
        if old_scope is not None and old_scope != scope:
            del staged[old_scope][name]
            touched.add(old_scope)
        staged[scope][name] = value
        touched.add(scope)
    if conflicts:
        print(json.dumps({"ok": False, "conflicts": sorted(conflicts)}))
        raise SystemExit(3)

    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    root.chmod(0o700)
    pending = []
    for scope in touched:
        values = staged[scope]
        target = root / f"{scope}.env"
        temp = root / f".{scope}.env.provisioning"
        fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write("".join(f"{key}={values[key]}\n" for key in sorted(values)))
        pending.append((temp, target))
    for temp, target in pending:
        os.replace(temp, target)
        target.chmod(0o600)

    manifest_path = root / "manifest.json"
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        if not isinstance(manifest, dict):
            raise ValueError("target manifest is not an object")
    except FileNotFoundError:
        manifest = {}
    except json.JSONDecodeError as error:
        raise ValueError("target manifest is invalid; refusing to replace it") from error
    for name, item in incoming.items():
        manifest[name] = {"scope": item["scope"]}
    temp = root / ".manifest.json.provisioning"
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        json.dump(manifest, stream, indent=2, sort_keys=True)
        stream.write("\n")
    os.replace(temp, manifest_path)
    manifest_path.chmod(0o600)
    modes = {p.name: oct(stat.S_IMODE(p.stat().st_mode)) for p in [manifest_path, *(root / f"{s}.env" for s in touched)]}
    print(json.dumps({"ok": True, "names": sorted(incoming), "modes": modes}))
except (KeyError, TypeError, ValueError, OSError, json.JSONDecodeError) as error:
    print(json.dumps({"ok": False, "error": str(error)}))
    raise SystemExit(2)
'''


def _choose_names(catalog: dict[str, dict[str, str]]) -> list[str]:
    if not sys.stdin.isatty():
        raise ValueError("interactive selection needs a terminal; use --keys NAME[,NAME] or explicit --all")
    names = sorted(catalog)
    print("Select credentials to provision (values remain hidden):")
    for index, name in enumerate(names, 1):
        print(f"  {index:>2}. {name:<32} [{catalog[name]['scope']}]")
    answer = input("Numbers or names (comma-separated), 'all', or Enter to cancel: ").strip()
    if not answer:
        return []
    if answer.lower() == "all":
        return names
    chosen = []
    for token in (part.strip() for part in answer.split(",")):
        name = names[int(token) - 1] if token.isdigit() and 0 < int(token) <= len(names) else token
        if name not in catalog:
            raise ValueError(f"unknown credential selection: {token}")
        if name not in chosen:
            chosen.append(name)
    return chosen


def cmd_provision(args) -> int:
    if not HOST.fullmatch(args.host) or args.host.startswith("-"):
        raise ValueError("host must be an SSH config alias, not options or a command")
    catalog = _catalog()
    if not catalog:
        raise ValueError("no registered credentials are available to provision")
    if args.all and args.keys:
        raise ValueError("choose either --keys or --all")
    if args.all:
        names = sorted(name for name, item in catalog.items() if item["scope"] in PORTABLE_SCOPES)
        protected = sorted(set(catalog) - set(names))
        if protected:
            print("protected credentials excluded from --all; select by name if truly needed: " + ", ".join(protected))
    elif args.keys:
        names = list(dict.fromkeys(name.strip() for name in args.keys.split(",") if name.strip()))
        unknown = sorted(set(names) - set(catalog))
        if unknown:
            raise ValueError(f"not registered: {', '.join(unknown)}")
    else:
        names = _choose_names(catalog)
    if not names:
        print("nothing provisioned")
        return 0

    # Secret values exist only in this in-memory payload and SSH stdin: never argv,
    # command text, logs, journals, stdout, or Git.
    payload = {"replace": args.replace, "credentials": {name: catalog[name] for name in names}}
    encoded = base64.b64encode(REMOTE_PROVISIONER.encode("utf-8")).decode("ascii")
    remote_command = f"python3 -c \"import base64;exec(base64.b64decode('{encoded}'))\""
    result = subprocess.run(
        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", args.host,
         remote_command],
        input=json.dumps(payload), capture_output=True, text=True, timeout=120,
    )
    try:
        report = json.loads(result.stdout)
    except json.JSONDecodeError:
        print(f"wsecret: target verification failed (ssh exit {result.returncode})", file=sys.stderr)
        return 1
    if not report.get("ok"):
        if report.get("conflicts"):
            print("wsecret: target already has: " + ", ".join(report["conflicts"]), file=sys.stderr)
            print("Nothing changed. Re-run with --replace only if overwriting those names is intended.", file=sys.stderr)
        else:
            print(f"wsecret: provisioning failed: {report.get('error', 'unknown target error')}", file=sys.stderr)
        return 1
    if report.get("names") != sorted(names) or any(mode != "0o600" for mode in report.get("modes", {}).values()):
        print("wsecret: target read-back did not match the requested names and private modes", file=sys.stderr)
        return 1
    print(f"provisioned {len(names)} credential(s) to {args.host}: {', '.join(sorted(names))}")
    print("verified names and mode 0600 on target; values were not displayed or logged")
    return 0


def cmd_import(args) -> int:
    source = Path(args.path).expanduser()
    values = _read_env(source)
    selected = {name: value for name, value in values.items() if looks_secret(name) and value}
    if not args.execute:
        for name in sorted(selected):
            print(f"would register {name}\t{suggest_scope(name)}")
        print(f"dry run: {len(selected)} credentials; values not displayed")
        return 0
    for name, value in selected.items():
        put(name, suggest_scope(name), value)
    print(f"registered {len(selected)} credentials from {source}; source was not modified")
    return cmd_doctor(args)


def cmd_run(args) -> int:
    env = dict(os.environ)
    for scope in args.scopes.split(","):
        scope = scope.strip()
        if scope not in SCOPES:
            print(f"wsecret: unknown scope {scope}", file=sys.stderr)
            return 2
        env.update(_read_env(ROOT / f"{scope}.env"))
    if not args.argv:
        print("wsecret: run requires a command after --", file=sys.stderr)
        return 2
    os.execvpe(args.argv[0], args.argv, env)
    return 127


def cmd_doctor(_args) -> int:
    problems = []
    if ROOT.exists() and stat.S_IMODE(ROOT.stat().st_mode) & 0o077:
        problems.append(f"directory is not private: {ROOT}")
    seen = {}
    for path in ROOT.glob("*.env") if ROOT.exists() else ():
        if stat.S_IMODE(path.stat().st_mode) & 0o077:
            problems.append(f"file is not mode 600: {path}")
        for name in _read_env(path):
            if name in seen:
                problems.append(f"{name} appears in both {seen[name]} and {path.stem}")
            seen[name] = path.stem
    manifest = _manifest()
    for name, scope in seen.items():
        if manifest.get(name, {}).get("scope") != scope:
            problems.append(f"manifest mismatch for {name}")
    if problems:
        for problem in problems:
            print(f"FAIL {problem}", file=sys.stderr)
        return 1
    print(f"wsecret doctor: ok ({len(seen)} registered credentials; values not read out)")
    return 0


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description=__doc__)
    sub = p.add_subparsers(dest="action", required=True)
    add = sub.add_parser("add"); add.add_argument("name", nargs="?"); add.add_argument("--scope", choices=SCOPES); add.set_defaults(fn=cmd_add)
    listing = sub.add_parser("list"); listing.set_defaults(fn=cmd_list)
    provision = sub.add_parser("provision", help="provision selected credentials to an SSH host")
    provision.add_argument("host")
    provision.add_argument("--keys", help="comma-separated credential names")
    provision.add_argument("--all", action="store_true", help="provision all portable provider credentials (LLM scope)")
    provision.add_argument("--replace", action="store_true", help="replace selected names already registered on target")
    provision.set_defaults(fn=cmd_provision)
    imported = sub.add_parser("import-env"); imported.add_argument("path"); imported.add_argument("--execute", action="store_true"); imported.set_defaults(fn=cmd_import)
    doctor = sub.add_parser("doctor"); doctor.set_defaults(fn=cmd_doctor)
    run = sub.add_parser("run"); run.add_argument("scopes"); run.add_argument("argv", nargs=argparse.REMAINDER); run.set_defaults(fn=cmd_run)
    return p


def main(argv=None) -> int:
    args = parser().parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError) as error:
        print(f"wsecret: {error}", file=sys.stderr)
        raise SystemExit(1)
